# Copy to .env for local development. Never commit .env.
# CI/CD reads these values from GitHub repository secrets of the same name.
VITE_APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key;IngestionEndpoint=https://your-region.in.applicationinsights.azure.com
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_ADSENSE_SLOT_IN_ARTICLE=your-in-article-slot-id
VITE_ADSENSE_SLOT_MULTIPLEX=your-multiplex-slot-id
VITE_POSTHOG_KEY=phc_your_project_token
VITE_POSTHOG_HOST=https://your-posthog-host
