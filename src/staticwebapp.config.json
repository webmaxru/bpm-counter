{
    "trailingSlash": "never",
    "routes": [
      {
        "route": "/",
        "rewrite": "/index.html"
      },
      {
        "route": "/upload",
        "rewrite": "/upload/index.html"
      },
      {
        "route": "/tools/tap-tempo",
        "rewrite": "/tools/tap-tempo/index.html"
      },
      {
        "route": "/tools/bpm-to-ms",
        "rewrite": "/tools/bpm-to-ms/index.html"
      },
      {
        "route": "/tools/bpm-converter",
        "rewrite": "/tools/bpm-converter/index.html"
      },
      {
        "route": "/guides/real-time-bpm-counter",
        "rewrite": "/guides/real-time-bpm-counter/index.html"
      },
      {
        "route": "/guides/how-bpm-detection-works",
        "rewrite": "/guides/how-bpm-detection-works/index.html"
      },
      {
        "route": "/guides/genre-bpm-ranges",
        "rewrite": "/guides/genre-bpm-ranges/index.html"
      },
      {
        "route": "/guides/beatmatching",
        "rewrite": "/guides/beatmatching/index.html"
      },
      {
        "route": "/guides/analyze-audio-url",
        "rewrite": "/guides/analyze-audio-url/index.html"
      },
      {
        "route": "/privacy",
        "rewrite": "/privacy/index.html"
      },
      {
        "route": "/terms",
        "rewrite": "/terms/index.html"
      },
      {
        "route": "/contact",
        "rewrite": "/contact/index.html"
      },
      {
        "route": "/affiliate-disclosure",
        "rewrite": "/affiliate-disclosure/index.html"
      },
      {
        "route": "/privacy.html",
        "redirect": "/privacy",
        "statusCode": 301
      },
      {
        "route": "/about",
        "rewrite": "/about/index.html"
      },
      {
        "route": "/images/*",
        "headers": {
          "cache-control": "must-revalidate, max-age=15770000"
        }
      }
    ],
    "responseOverrides": {
      "400": {
        "rewrite": "/400.html"
      },
      "404": {
        "rewrite": "/404.html"
      }
    },
    "globalHeaders": {
      "X-Content-Type-Options": "nosniff",
      "X-Frame-Options": "DENY"
    },
    "mimeTypes": {
      ".json": "text/json",
      ".webmanifest": "application/manifest+json"
    }
  }