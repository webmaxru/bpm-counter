{
    "routes": [
      {
        "route": "/",
        "rewrite": "/index.html"
      },
      {
        "route": "/upload",
        "rewrite": "/upload/index.html"
      },
      {
        "route": "/tools/tap-tempo",
        "rewrite": "/tools/tap-tempo/index.html"
      },
      {
        "route": "/tools/bpm-to-ms",
        "rewrite": "/tools/bpm-to-ms/index.html"
      },
      {
        "route": "/tools/bpm-converter",
        "rewrite": "/tools/bpm-converter/index.html"
      },
      {
        "route": "/guides/real-time-bpm-counter",
        "rewrite": "/guides/real-time-bpm-counter/index.html"
      },
      {
        "route": "/guides/how-bpm-detection-works",
        "rewrite": "/guides/how-bpm-detection-works/index.html"
      },
      {
        "route": "/guides/genre-bpm-ranges",
        "rewrite": "/guides/genre-bpm-ranges/index.html"
      },
      {
        "route": "/guides/beatmatching",
        "rewrite": "/guides/beatmatching/index.html"
      },
      {
        "route": "/guides/analyze-audio-url",
        "rewrite": "/guides/analyze-audio-url/index.html"
      },
      {
        "route": "/privacy",
        "rewrite": "/privacy/index.html"
      },
      {
        "route": "/terms",
        "rewrite": "/terms/index.html"
      },
      {
        "route": "/contact",
        "rewrite": "/contact/index.html"
      },
      {
        "route": "/affiliate-disclosure",
        "rewrite": "/affiliate-disclosure/index.html"
      },
      {
        "route": "/privacy.html",
        "redirect": "/privacy",
        "statusCode": 301
      },
      {
        "route": "/about/",
        "redirect": "/about",
        "statusCode": 301
      },
      {
        "route": "/about",
        "rewrite": "/index.html",
        "headers": {
          "X-Robots-Tag": "noindex, nofollow"
        }
      },
      {
        "route": "/login/",
        "redirect": "/login",
        "statusCode": 301
      },
      {
        "route": "/login",
        "rewrite": "/index.html",
        "headers": {
          "X-Robots-Tag": "noindex, nofollow"
        }
      },
      {
        "route": "/account/",
        "redirect": "/account",
        "statusCode": 301
      },
      {
        "route": "/account",
        "allowedRoles": ["authenticated"],
        "rewrite": "/index.html",
        "headers": {
          "X-Robots-Tag": "noindex, nofollow"
        }
      },
      {
        "route": "/admin/",
        "redirect": "/admin",
        "statusCode": 301
      },
      {
        "route": "/admin",
        "allowedRoles": ["administrator"],
        "rewrite": "/index.html",
        "headers": {
          "X-Robots-Tag": "noindex, nofollow"
        }
      },
      {
        "route": "/admin/*",
        "allowedRoles": ["administrator"],
        "rewrite": "/index.html",
        "headers": {
          "X-Robots-Tag": "noindex, nofollow"
        }
      },
      {
        "route": "/images/*",
        "headers": {
          "cache-control": "must-revalidate, max-age=15770000"
        }
      },
      {
        "route": "/login-account",
        "rewrite": "/.auth/login/twitter?post_login_redirect_uri=/account"
      },
      {
        "route": "/login-twitter",
        "rewrite": "/.auth/login/twitter"
      },
      {
        "route": "/.auth/login/aad",
        "statusCode": 404
      },
      {
        "route": "/logout",
        "redirect": "/.auth/logout?post_logout_redirect_uri=/about"
      },
      {
        "route": "/aboutme",
        "redirect": "/about",
        "statusCode": 301
      }
    ],
    "responseOverrides": {
      "400": {
        "rewrite": "/400.html"
      },
      "401": {
        "redirect": "/login",
        "statusCode": 302
      },
      "403": {
        "rewrite": "/400.html"
      },
      "404": {
        "rewrite": "/404.html"
      }
    },
    "globalHeaders": {
      "X-Powered-By": "Maxim Salnikov and Azure Static Web Apps",
      "X-Content-Type-Options": "nosniff",
      "X-Frame-Options": "DENY"
    },
    "mimeTypes": {
      ".json": "text/json",
      ".webmanifest": "application/manifest+json"
    }
  }